# Copy to .env.local. Never commit .env.local.
# Local and preview use the database name wedding-home-dev.
# VERCEL_ENV=production must use the database name wedding-home.
# Wedding creation needs a replica set. Atlas, including the free tier, is one.
# A local mongod needs --replSet rs0 and one rs.initiate().

NEXT_PUBLIC_APP_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/wedding-home-dev

# At least 32 characters each. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters

S3_BUCKET=wedding-home-dev
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

RESEND_API_KEY=replace-me
EMAIL_FROM=The Wedding Home <noreply@example.com>

GOOGLE_PLACES_API_KEY=replace-me
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=replace-me
